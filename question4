#The user enter a string containing a number (e.g ,"45").
#convert it to:
# an integer
# a float
# a string again
# print all three value with their type
user_input = input("enter a number:")
as_int = int(user_input)
as_float = float(user_input)
as_str = str(user_input)
print(type(as_int) , as_int)
print(type(as_float) , as_float)
print(type(as_str) , as_str)